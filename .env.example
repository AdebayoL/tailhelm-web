# Copy to .env.local for local development. In Vercel, set these under Project Settings > Environment Variables.
# Both values are public by design (row-level security limits what the key can do).
# Supabase dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reminders: phone notifications and the scheduler. Server-only except the public VAPID key.
# Supabase dashboard > Project Settings > API Keys > Secret keys. Never expose it to the browser.
SUPABASE_SECRET_KEY=
# A VAPID key pair for web push (npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# At least 32 random characters. Supabase sends it to /api/reminders/run (supabase/setup/reminders-schedule.sql).
CRON_SECRET=
